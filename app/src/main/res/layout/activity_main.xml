<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0D10">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:padding="6dp"
        android:background="#FF15181D">
        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="@string/hint_url"
            android:textColor="#FFE6E6E6"
            android:textColorHint="#FF7A7F86"
            android:background="@android:color/transparent"
            android:inputType="textUri|textNoSuggestions"
            android:imeOptions="actionGo"
            android:singleLine="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:importantForAutofill="no"/>
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_more"
            android:contentDescription="menu"/>
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:scrollbars="none"
        android:background="#FF101318">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:padding="4dp">
            <Button android:id="@+id/qGoogle" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/search_google" android:backgroundTint="#FF1E2228" android:textColor="#FFE6E6E6" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/qYandex" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/search_yandex" android:backgroundTint="#FF1E2228" android:textColor="#FFE6E6E6" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/qDDG" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/search_ddg" android:backgroundTint="#FF1E2228" android:textColor="#FFE6E6E6" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/qBrave" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/search_brave" android:backgroundTint="#FF1E2228" android:textColor="#FFE6E6E6" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/qStartpage" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/search_startpage" android:backgroundTint="#FF1E2228" android:textColor="#FFE6E6E6" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/qGpt" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/quick_gpt" android:backgroundTint="#FF1E2228" android:textColor="#FFE6E6E6" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/qWiki" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/quick_wiki" android:backgroundTint="#FF1E2228" android:textColor="#FFE6E6E6" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/qPerplexity" android:layout_width="wrap_content" android:layout_height="match_parent" android:text="@string/quick_perplexity" android:backgroundTint="#FF1E2228" android:textColor="#FFE6E6E6"/>
        </LinearLayout>
    </HorizontalScrollView>
    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
